function SK=Tspec(spc,a,b,c,d,q)

if nargin>=4
    Xi=a;
    KB=b;
    K=c;
    k=d;
elseif nargin==3
   Xi=a(1);
    KB=a(2);
    K=b;
end

if spc=='K'
    %Roget 2
%     q=3.9; %5.26;
    phi=KB/sqrt(2*q);
    y=K/phi;
    f=y.*exp(-sqrt(3)*y); %Kraichnan
    SK=Xi/(2*k*KB)*sqrt(2*q)*f;
elseif spc=='B'
    %Roget 2
%     q=3.9;
    phi=KB/sqrt(2*q);
    y=K/phi;
    f=y.*(exp(-y.^2/2)-y.*sqrt(pi()/2).*(1-erf(y/sqrt(2)))); %Batchelor
    SK=Xi/(2*k*KB)*sqrt(2*q)*f;
end
SK = SK;
end
