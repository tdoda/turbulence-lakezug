function [eps, W, fit_flag, MAD, MADc]=dis_spec_EPFL(pres,x0,px0,K1,K2,fn,visco,W,sL,sOV,plt,folder_out,noise_corr,sh_number)
%ps is the accelerometer signal. if 0. it does not apply correction
% [eps,Kc,epsN,KcN,MAD,MADf, MADc,fit_flag]
eps=NaN;Kc=NaN;epsN=NaN;KcN=NaN;

if nargin<6
    plt=0;
end

[~,ncsh]=size(x0);
[~,ncA]=size(px0);
if (ncA~=ncsh)
    disp('Error: number of columns of AA and sh is not the same')
    pause
else
    nc=ncsh;
end
    
%deletes nan and detrend
I = isfinite(x0); I=find(I(:,1)==1 & I(:,nc)==1); % generalized for the case with 2 sh
x0 = x0(I,:);
px0 = px0(I,:);
pres = pres(I);
x = detrend(x0,'linear');
px = detrend(px0,'linear');

pres1 = pres;
I = isfinite(x); I=find(I(:,1)==1 & I(:,nc)==1);
x = x(I,:);
px = px(I,:);
pres = pres(I);

if isempty(x) |  sum(x==0)==length(pres)
    return;
end

Fs=length(pres)./ (max(pres)-min(pres));
W=W;

%if sL = 0, sL = length(x)/2
if sL == 0
    sL = round(length(x(:,1))/2)-1;
end
if sOV == 0
    sOV = round(sL/2);
end

%degrees of freedom acording to me
%Nseg = floor((length(x)-sOV)/(sL-sOV));
%dof = 2*Nseg;
%more complex (methods in oceanography book)
NsegM = 2 * floor(length(x(:,1))/sL)-1;
dof = 1.9*NsegM; %according to ODAS 4.4
MADc = sqrt(2/dof);

if nc==1
%     [PSD0,K] = pwelch(x-nanmean(x),hann(sL),sOV,sL,Fs,'onesided');
    [PSD0,K] = csd_odas(x,x,sL,Fs,[],sOV,'linear');
elseif nc==2
    if strcmp(sh_number,'sh1')
        column_index=1;
    elseif strcmp(sh_number,'sh2')
        column_index=2;
    end
    [PSD0,K,~,~] = csd_matrix_odas(x(:,column_index),x(:,column_index),sL,Fs,[],sOV,'linear');
end

%% Estimate epsilon only if we have points for K<K2
% (may not be the case if fft_length is short, e.g., at the begginning
% or end of the profile.
if K(2)<K2
    if strcmpi(noise_corr,'Goodman')
        if nc==1
            if sum(abs(px))>0
                %             [PSDps, ~] = pwelch(px-nanmean(px),hann(sL),sOV,sL,Fs,'onesided');
                %             [CPS, ~] = cpsd(x-nanmean(x),px-nanmean(px),hann(sL),sOV,sL,Fs,'onesided');
                [PSDps, ~] = csd_odas(px,px,sL,Fs,[],sOV,'linear');
                [CPS, ~, ~, ~] = csd_matrix_odas(x,px,sL,Fs,[],sOV,'linear');
                H = CPS./PSDps;
                PSDcont = abs(H).^2.*PSDps;
                PSD = PSD0 - PSDcont;
            else
                PSD = PSD0;
            end
        elseif nc==2
            [PSD, ~,~,~,~] = clean_shear_spec(px, x, sL, Fs);
            PSD = permute(PSD, [3 1 2]);
            PSD = squeeze(PSD(:, column_index, column_index));
        end
    elseif strcmpi(noise_corr,'none')
        PSD = PSD0;
    end
    
    if nc==2
        x=x(:, column_index);
    end
    
    %applies spatial response correction
    Hsr = 1./(1+(K./48).^2);
    PSD = PSD./Hsr;
    PSD0 = PSD0./Hsr;
    %rockland spectrum
    %[PSDr,Kr] = csd_odas(x-nanmean(x),x-nanmean(x),sL,Fs,[],sOV,'linear');
    
    
    dK = K(2) - K(1);
    mpres=mean(pres);
    
    iK1=find(K>=K1,1,'first');
    iK2=find(K>=K2,1,'first');
    if iK2 == iK1
        iK2 = iK2+2;
    end
    % Seb: adjust Kn = upper integration range moving from f to k
    Kn=fn/W; Kn=min(150,Kn);       % is not wise to extend the correction beyond 150 cpm because, at that wavenumber the spectrum is boosted by a factor of >10. We used a limit of 100 cpm
    iKn=find(K>=Kn,1,'first');
    
    %EPSILON ITERATIVE CALCULATION
    iK3=iK2;
    K3=K(iK3);
    Kc0=K2;
    flag=0;
    while flag==0        
        eps=7.5*visco*sum( (PSD(iK1+1:iK3)+PSD(iK1:iK3-1)).* (K(iK1+1:iK3)-K(iK1:iK3-1)) )/2;
        %%%%
%        Kc=1/(2*pi())*(eps./visco^3).^(1/4);
         Kc=0.121*(eps./visco^3).^(1/4);
        %%%%
        if abs(Kc-Kc0)<=2*dK
            flag = 1;
%             iK3 = find(K>=Kc,1,'first');
            iK3 = find(K<=Kc,1,'last');  % SEB: this is more cautelative to avoid the noisy part
        elseif Kc<=Kn
            inc = (Kc-K3)/abs(Kc-K3);
            iK3= iK3+inc; %find(K >= Kc,1,'first');
            K3=K(iK3);
            Kc0 = Kc;
        else
            iK3=iKn;
            flag = 2;
        end
        
    end
    %%%%
    Kc=1/(2*pi())*(eps./visco^3).^(1/4);
    %%%%
    
    eps=7.5*visco*sum( (PSD(iK1+1:iK3)+PSD(iK1:iK3-1)).* (K(iK1+1:iK3)-K(iK1:iK3-1)) )/2;
    Kc=1/(2*pi())*(eps./visco^3).^(1/4);
    
    
    
    %now for lost variance
    NAS=nasmyth(eps,visco,K);
    varianceN=sum( (NAS(iK1+1:iK3)+NAS(iK1:iK3-1)).* (K(iK1+1:iK3)-K(iK1:iK3-1)) )/2;
    epsUN=7.5*visco*varianceN;
    %     if abs(eps-epsUN)/epsUN>0.05
    eps=eps*eps/epsUN;
    Kc=1/(2*pi())*(eps./visco^3).^(1/4);
    %     end
    
    
    %EPSILON CALCULATION BY FITTING TO NASMYTH
    epsN = nan;
    KcN = nan;
    try
%         epsN=nlinfit(K(iK1:iKn),log(PSD(iK1:iKn)),@(e,kk)log(nasmyth(e,visco,kk)),10^-9);
        epsN=nlinfit(K(iK1:iK3),log(PSD(iK1:iK3)),@(e,kk)log(nasmyth(e,visco,kk)),10^-9);    % SEB changed from iKn to iK3 because I changed the meaning of Kn (higher values)
        KcN=1/(2*pi())*(eps./visco^3).^(1/4);
    end
    K3=K(iK3);
    
    NAS2=nasmyth(epsN,visco,K);
    NAS=nasmyth(eps,visco,K);
    
%     MAD =  mean(abs(log10(PSD(iK1:iK3)./NAS(iK1:iK3))));
%     MADf = mean(abs(log10(PSD(iK1:iKn)./NAS(iK1:iKn))));
MAD = mean( abs( (PSD(iK1:iK3)./NAS(iK1:iK3)) - mean(PSD(iK1:iK3)./NAS(iK1:iK3)) )  );   %SEB as in Ruddick et al., 2000
MADf = mean( abs( (PSD(iK1:iKn)./NAS(iK1:iKn)) - mean(PSD(iK1:iKn)./NAS(iK1:iKn)) )  );
    fit_flag = 0;
    if MAD<2*MADc
        fit_flag = 1;
    end
    
    if plt(2) ~=0
    %%
% % % % %         fh=figure(11);
% % % % %         clf
% % % % %         set(fh,'color','white','Units', 'Centimeters', 'Position', [0,0,18,8],...
% % % % %     'PaperUnits', 'Centimeters', 'PaperSize', [18,8]);
% % % % %         axes('position',[0.07,0.1,0.2,0.83])
% % % % %         plot(x,pres,'k')
% % % % %         xlim([-2, 2])
% % % % %         hold on
% % % % %         axis ij
% % % % %         grid('on')
% % % % %         xlabel('Shear [s^{-1}]')
% % % % %         ylabel('Pressure [dbar]')
% % % % %         set(gca,'fontsize',10)
% % % % % 
% % % % %         axes('position',[0.40,0.16,0.55,0.82])
% % % % %         loglog(logspace(0,3,100),nasmyth(logspace(-11,-3,9),visco,logspace(0,3,100)),'color',[0.60 0.60 0.60])
% % % % %         hold on
% % % % %         for i=1:9
% % % % %             text(1.5,min(nasmyth(10^(-12+i),visco,[1.5 2])),['10^{',num2str(-12+i),'} W/kg'],'color',[0.60 0.60 0.60])
% % % % %         end
% % % % %         loglog(K,PSD0,'color',[0.5,0.5,0.5])
% % % % %         %loglog(Kr,PSDr,'b')
% % % % %         loglog(K,PSD,'k')
% % % % %         loglog(K(1:iK3),PSD(1:iK3),'ko', 'markersize',4)
% % % % %         loglog(K,NAS,'k','linewidth',2)
% % % % % %         loglog(K,NAS2,'--k','linewidth',2)
% % % % %         ylim([10^-9,2])
% % % % %         xlim([1 10^3])
% % % % %         line([Kc,Kc],ylim,'color','k')
% % % % %         text(1.01*Kc,2.4e-9,'k_K')
% % % % %         text(1.01*Kn,2.4e-9,'k_U')
% % % % %         line([Kn,Kn],ylim,'color','k','linestyle','--')
% % % % %         text(1.2,10^-0.5,['\epsilon _{iter} = ', num2str(eps,'%1.3e'),' W/kg'],'horizontalalignment','left','fontsize',7)
% % % % % %         text(1.2,10^-1,['\epsilon _{Nas}= ', num2str(epsN,'%1.3e'),' W/kg'],'horizontalalignment','left')
% % % % %         text(2, 10^-8, ['MAD = ', num2str(MAD, '%1.2f'),'(', num2str(MADc*2, '%1.2f'),')'],'horizontalalignment','left','fontsize',7)
% % % % % %         text(2, 10^-8.5, ['MAD = ', num2str(MADf, '%1.2f')],'horizontalalignment','left')
% % % % % %         title([num2str(mpres), 'm'])
% % % % %         set(gca,'fontsize',10)
% % % % %         xlabel('k (cpm)')
% % % % %         yl=ylabel('S_{sh} (s^{-2} cpm^{-1})'); yl.Position(1) = 0.4;  
% % % % %         
% % % % %         set(ax1,'position',[0.505    0.58    0.38    0.38]);
% % % % %         a1 = annotation('textbox', [0.9 0.3 1 0.1],'String', 'b.','EdgeColor', 'none','HorizontalAlignment', 'left',...
% % % % %             'fontsize',10,'FontName','Arial');
% % % % %         set(a1,'position',[0.835 0.62 0 0]);
% % % % %         set(cb,'visible','off')
% % % % %     
% % % % %         saveas(gcf,[folder_out '/Spec_z= ', num2str(mpres), ' m, sensor = ' sh_number '.png'])
% % % % %         
        
% for data paper
        fh=figure(11);
        clf
        set(fh,'color','white','Units', 'Centimeters', 'Position', [0,0,16,7],...
    'PaperUnits', 'Centimeters', 'PaperSize', [16,7]);
        axes('position',[0.08,0.175,0.2,0.8])
        plot(x,pres,'k')
%         xlim([-2, 2])
        hold on
        axis ij
        grid('on')
        xlabel('Shear [s^{-1}]','fontsize',10)
        ylabel('Pressure [dbar]','fontsize',10)

        ax=axes('position',[0.40,0.175,0.55,0.8]);
        loglog(logspace(0,3,100),nasmyth(logspace(-11,-3,9),visco,logspace(0,3,100)),'color',[0.60 0.60 0.60])
        hold on
            text(1.1,0.5,'\epsilon_{th} [m^2s^{-3}]','color',[0.60 0.60 0.60],'fontsize',8,'horizontalalignment','left')
        for i=1:9
            text(1.1,min(nasmyth(10^(-12+i),visco,[1.5 2])),['10^{',num2str(-12+i),'}'],'color',[0.60 0.60 0.60],'fontsize',7)
        end
        s_raw=loglog(K,PSD0,'-k','linewidth',0.5);
        %loglog(Kr,PSDr,'b')
        s_corr= loglog(K,PSD,'-','color',[75 97 209]/255,'linewidth',0.75);
        loglog(K(1:iK3),PSD(1:iK3),'ok','markerfacecolor',[75 97 209]/255, 'markersize',5)
        s_fit = loglog(K,NAS,'-','color',[75 97 209]/255,'linewidth',2);
%         loglog(K,NAS2,'--k','linewidth',2)
        ylim([10^-9,2])
        xlim([1 10^3])
%         line([Kc,Kc],ylim,'color','k')
%         line([Kn,Kn],ylim,'color','k','linestyle','--')
        plot(Kc,1.27E-9,'^','markeredgecolor','k','markerfacecolor','k','markersize',5)
        plot(fn/W,1.27E-9,'^','markeredgecolor',[0.5 0.5 0.5],'markerfacecolor',[0.5 0.5 0.5],'markersize',5)
        plot(150,1.27E-9,'^','markeredgecolor','k','markerfacecolor',[1 1 1],'markersize',5)
%         plot(K(iK3),1.27E-9,'^','markeredgecolor',[75 97 209]/255,'markerfacecolor',[75 97 209]/255,'markersize',5)
%         plot(K(iK1),1.27E-9,'^','markeredgecolor',[75 97 209]/255,'markerfacecolor',[75 97 209]/255,'markersize',5)

%         text(Kc,2.2e-9,'k_K','horizontalalignment','left','rotation',90,'fontsize',8)
%         text(0.9*fn/W,2.2e-9,'0.9 k_{AA}','horizontalalignment','left','rotation',90,'fontsize',8)
%         text(1.15*150,2.2e-9,'150 cpm','horizontalalignment','left','rotation',90,'fontsize',8)
%         text(K(iK3),2.2e-9,'k_U','horizontalalignment','left','rotation',90,'fontsize',8)
%         text(K(iK1),2.2e-9,'k_L','horizontalalignment','left','rotation',90,'fontsize',8)

        text(1.2,10^-7.2,['\epsilon_{S} = ', num2str(eps,'%1.2e'),' m^2 s^{-3}'],'horizontalalignment','left','fontsize',8)
%         text(1.2,10^-1,['\epsilon _{Nas}= ', num2str(epsN,'%1.3e'),' W/kg'],'horizontalalignment','left')
        text(1.2, 10^-7.8, ['MAD = ', num2str(MAD, '%1.2f'),' (', num2str(2*MADc, '%1.2f'),')'],'horizontalalignment','left','fontsize',8)
%         text(1.2, 10^-8.55, ['MAD_c = ', num2str(2*MADc, '%1.2f')],'horizontalalignment','left','fontsize',8)
        %         text(2, 10^-8.5, ['MAD = ', num2str(MADf, '%1.2f')],'horizontalalignment','left')
%         title([num2str(mpres), 'm'])
        xlabel('k [cpm]','fontsize',10)
        yl=ylabel('\Psi_S [s^{-2} cpm^{-1}]','fontsize',10); yl.Position(1) = 0.55; 
        set(gca,'ytick',[1e-10 1e-8 1e-6 1e-4 1e-2 1e0]);
        legend([s_raw,s_corr,s_fit],{'Corrected spec.','Denoised spec.','Nasmyth spec. (iteration)'})
        grid on; ax.GridAlpha=0.1; 
        set(gca, 'xminorgrid', 'on')
        set(gca,'MinorGridLineStyle','-','MinorGridAlpha',0.1)
        set(gca,'GridLineStyle','-')

        saveas(gcf,[folder_out '/Spec_z= ', num2str(mpres), ' m, sensor = ' sh_number '.pdf'])
        saveas(gcf,[folder_out '/Spec_z= ', num2str(mpres), ' m, sensor = ' sh_number '.png'])
        
        %%             pause()
    end
else
    eps=NaN; W=NaN; fit_flag=NaN; MAD=NaN; MADc=NaN;
end
